# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# Database (Supabase local)
DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# notification-service (OTP delivery) — must match INTERNAL_API_KEY there
NOTIFICATION_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_INTERNAL_API_KEY=

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500

# Security (Supabase JWT)
JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1

# Keycloak login theme applied to the app realm at startup (themes live in
# Infrastructure/keycloak/themes). Empty = leave the realm's theme unchanged.
KEYCLOAK_LOGIN_THEME=cliniqai

# Observability
ZIPKIN_URL=http://localhost:9411/api/v2/spans
TRACING_SAMPLE_RATE=1.0

# AWS (CI/CD — set in GitHub Secrets)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ACCOUNT_ID=
