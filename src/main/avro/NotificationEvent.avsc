{
  "type": "record",
  "name": "NotificationEvent",
  "namespace": "com.flowbinary.platform.event.avro",
  "doc": "Avro envelope for all notification-triggering events published by platform-service to platform.notification.events",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique event UUID — used for idempotency"
    },
    {
      "name": "eventType",
      "type": "string",
      "doc": "Logical event type, e.g. USER_CREATED, USER_UPDATED, USER_DELETED"
    },
    {
      "name": "occurredAt",
      "type": "string",
      "doc": "ISO-8601 UTC timestamp when the event occurred"
    },
    {
      "name": "source",
      "type": "string",
      "default": "platform-service",
      "doc": "Service that emitted this event"
    },
    {
      "name": "audience",
      "type": {
        "type": "record",
        "name": "EventAudience",
        "doc": "Defines who should receive the resulting notification",
        "fields": [
          {
            "name": "tenantId",
            "type": "string",
            "doc": "Target tenant UUID"
          },
          {
            "name": "scope",
            "type": {
              "type": "enum",
              "name": "AudienceScope",
              "symbols": ["USER", "TENANT", "SYSTEM"],
              "doc": "USER = specific users, TENANT = all tenant members, SYSTEM = platform-wide"
            }
          },
          {
            "name": "userIds",
            "type": { "type": "array", "items": "string" },
            "default": [],
            "doc": "Target user UUIDs — used when scope=USER"
          }
        ]
      }
    },
    {
      "name": "data",
      "type": { "type": "map", "values": "string" },
      "default": {},
      "doc": "Flat string key-value map for Handlebars template rendering (firstName, email, role, etc.)"
    },
    {
      "name": "idempotencyKey",
      "type": ["null", "string"],
      "default": null,
      "doc": "Optional idempotency key — prevents duplicate notification delivery"
    }
  ]
}
